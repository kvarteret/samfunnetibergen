{
  "name": "samfunnetibergen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3187",
    "build": "next build",
    "start": "next start -p 3187",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "studio:register": "sanity deploy --external",
    "studio:seed": "sanity exec scripts/seed-sanity-content.mjs --with-user-token",
    "sanity:schema": "sanity schema extract --enforce-required-fields --path .sanity/schema.json",
    "sanity:typegen": "npm run sanity:schema && sanity typegen generate && SANITY_TYPEGEN_TARGET=studio sanity typegen generate && biome format --write src/lib/sanity/sanity.types.ts src/studio/sanity.types.ts",
    "sanity:migrate:defaults": "sanity exec scripts/migrate-sanity-defaults.ts --with-user-token",
    "sanity:migrate:defaults:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-sanity-defaults.ts --with-user-token",
    "sanity:migrate:volunteer-links": "sanity exec scripts/migrate-retired-volunteer-links.ts --with-user-token",
    "sanity:migrate:volunteer-links:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-retired-volunteer-links.ts --with-user-token",
    "sanity:migrate:nyttig": "sanity exec scripts/migrate-nyttig-info.ts --with-user-token",
    "sanity:migrate:nyttig:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-nyttig-info.ts --with-user-token",
    "sanity:migrate:repair-content": "sanity exec scripts/repair-sanity-content.ts --with-user-token",
    "sanity:migrate:repair-content:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/repair-sanity-content.ts --with-user-token",
    "sanity:audit": "sanity exec scripts/audit-sanity-content.ts --with-user-token",
    "crescat:introspect": "tsx scripts/crescat-form-introspect.ts",
    "crescat:cleanup": "tsx scripts/crescat-delete-events.ts",
    "test": "vitest run --coverage",
    "lint": "eslint",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@posthog/nextjs-config": "^1.9.68",
    "@sanity/assist": "^6.1.1",
    "@sanity/orderable-document-list": "^1.5.1",
    "@sanity/vision": "^5.23.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "^5.97.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.7.0",
    "nanoid": "^5.1.11",
    "next": "16.2.9",
    "next-intl": "^4.9.0",
    "next-sanity": "^13.1.0",
    "posthog-js": "^1.386.8",
    "posthog-node": "^5.37.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rrule": "^2.8.1",
    "sanity": "^5.31.1",
    "sanity-plugin-markdown": "^8.0.5",
    "styled-components": "^6.1.15",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "ws": "8.21.0",
    "qs": "6.15.3",
    "postcss": "8.5.15",
    "hono": "4.12.27",
    "dompurify": "3.4.11",
    "ip-address": "10.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
