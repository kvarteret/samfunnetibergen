{
  "name": "samfunnetibergen-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter @samfunnet/web run dev",
    "dev:studio": "pnpm --filter @samfunnet/studio run dev",
    "build": "pnpm run build:web && pnpm run build:studio",
    "build:web": "pnpm --filter @samfunnet/web run build",
    "build:studio": "pnpm --filter @samfunnet/studio run build",
    "start": "pnpm --filter @samfunnet/web run start",
    "studio": "pnpm run dev:studio",
    "studio:build": "pnpm run build:studio",
    "studio:deploy": "pnpm --filter @samfunnet/studio run studio:deploy",
    "studio:register": "pnpm --filter @samfunnet/studio run studio:register",
    "studio:seed": "pnpm --filter @samfunnet/studio run studio:seed",
    "sanity:schema": "pnpm --filter @samfunnet/studio run sanity:schema",
    "sanity:typegen:web": "pnpm --filter @samfunnet/studio run sanity:typegen:web",
    "sanity:typegen:studio": "pnpm --filter @samfunnet/studio run sanity:typegen:studio",
    "sanity:typegen": "pnpm run sanity:schema && pnpm run sanity:typegen:web && pnpm run sanity:typegen:studio && pnpm exec biome format --write apps/web/src/lib/sanity/sanity.types.ts apps/studio/src/studio/sanity.types.ts",
    "sanity:audit:group-locales": "pnpm --filter @samfunnet/studio run sanity:audit:group-locales",
    "sanity:audit:i18n": "pnpm --filter @samfunnet/studio run sanity:audit:i18n",
    "sanity:audit": "pnpm --filter @samfunnet/studio run sanity:audit",
    "crescat:introspect": "pnpm --filter @samfunnet/web run crescat:introspect",
    "crescat:cleanup": "pnpm --filter @samfunnet/web run crescat:cleanup",
    "typecheck": "pnpm run typecheck:web && pnpm run typecheck:studio && pnpm run typecheck:domain",
    "typecheck:web": "pnpm --filter @samfunnet/web run typecheck",
    "typecheck:studio": "pnpm --filter @samfunnet/studio run typecheck",
    "typecheck:domain": "pnpm --filter @samfunnet/content-domain run typecheck",
    "route-typegen": "pnpm --filter @samfunnet/web run route-typegen",
    "test": "pnpm run test:web && pnpm run test:studio && pnpm run test:domain",
    "test:web": "pnpm --filter @samfunnet/web run test",
    "test:studio": "pnpm --filter @samfunnet/studio run test",
    "test:domain": "pnpm --filter @samfunnet/content-domain run test",
    "format:check": "pnpm exec biome format .",
    "format": "pnpm exec biome format --write .",
    "lint": "pnpm exec biome check .",
    "check": "pnpm exec biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.7",
      "ws": "8.21.0",
      "qs": "6.16.0",
      "hono": "4.13.8",
      "dompurify": "3.4.13",
      "ip-address": "10.4.0",
      "sharp": "0.35.4",
      "prismjs": "1.30.0",
      "adm-zip": "0.6.1",
      "js-yaml@^3": "3.15.2",
      "js-yaml@^4": "4.3.2",
      "smol-toml": "1.7.1",
      "fflate@^0.4": "0.4.9",
      "baseline-browser-mapping": "2.11.24",
      "browserslist": "4.29.0",
      "undici@^7": "7.29.0",
      "uuid@^10": "11.1.1",
      "@sanity/client": "8.6.2"
    }
  }
}
