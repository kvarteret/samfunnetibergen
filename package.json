{
  "name": "samfunnetibergen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3187",
    "build": "next build",
    "start": "next start -p 3187",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "studio:register": "sanity deploy --external",
    "studio:seed": "sanity exec scripts/seed-sanity-content.mjs --with-user-token",
    "sanity:schema": "sanity schema extract --enforce-required-fields --path .sanity/schema.json",
    "sanity:typegen": "npm run sanity:schema && sanity typegen generate --config-path sanity-typegen.frontend.json && sanity typegen generate --config-path src/studio/sanity-typegen.json && biome format --write src/lib/sanity/sanity.types.ts src/studio/sanity.types.ts",
    "lint": "eslint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@sanity/orderable-document-list": "^1.5.1",
    "@sanity/vision": "^5.23.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "^5.97.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.7.0",
    "nanoid": "^5.1.11",
    "next": "16.2.1",
    "next-intl": "^4.9.0",
    "next-sanity": "^12.4.0",
    "posthog-js": "^1.366.2",
    "posthog-node": "^5.29.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rrule": "^2.8.1",
    "sanity": "^5.24.0",
    "sanity-plugin-markdown": "^8.0.5",
    "sanity-plugin-recurring-dates": "^2.0.2",
    "styled-components": "^6.1.15",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.4",
    "@storybook/nextjs-vite": "^10.4.4",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-plugin-storybook": "^10.4.4",
    "mockdate": "^3.0.5",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.60.0",
    "shadcn": "^4.1.0",
    "storybook": "^10.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
