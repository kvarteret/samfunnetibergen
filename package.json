{
  "name": "samfunnetibergen-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace @samfunnet/web run dev",
    "dev:studio": "npm --workspace @samfunnet/studio run dev",
    "build": "npm run build:web && npm run build:studio",
    "build:web": "npm --workspace @samfunnet/web run build",
    "build:studio": "npm --workspace @samfunnet/studio run build",
    "start": "npm --workspace @samfunnet/web run start",
    "studio": "npm run dev:studio",
    "studio:build": "npm run build:studio",
    "studio:deploy": "npm --workspace @samfunnet/studio run studio:deploy",
    "studio:register": "npm --workspace @samfunnet/studio run studio:register",
    "studio:seed": "npm --workspace @samfunnet/studio run studio:seed",
    "sanity:schema": "npm --workspace @samfunnet/studio run sanity:schema",
    "sanity:typegen:web": "npm --workspace @samfunnet/studio run sanity:typegen:web",
    "sanity:typegen:studio": "npm --workspace @samfunnet/studio run sanity:typegen:studio",
    "sanity:typegen": "npm run sanity:schema && npm run sanity:typegen:web && npm run sanity:typegen:studio && npx --no-install biome format --write apps/web/src/lib/sanity/sanity.types.ts apps/studio/src/studio/sanity.types.ts",
    "sanity:migrate:defaults": "npm --workspace @samfunnet/studio run sanity:migrate:defaults",
    "sanity:migrate:defaults:write": "npm --workspace @samfunnet/studio run sanity:migrate:defaults:write",
    "sanity:migrate:volunteer-links": "npm --workspace @samfunnet/studio run sanity:migrate:volunteer-links",
    "sanity:migrate:volunteer-links:write": "npm --workspace @samfunnet/studio run sanity:migrate:volunteer-links:write",
    "sanity:migrate:group-slugs": "npm --workspace @samfunnet/studio run sanity:migrate:group-slugs",
    "sanity:migrate:group-slugs:write": "npm --workspace @samfunnet/studio run sanity:migrate:group-slugs:write",
    "sanity:migrate:nyttig": "npm --workspace @samfunnet/studio run sanity:migrate:nyttig",
    "sanity:migrate:nyttig:write": "npm --workspace @samfunnet/studio run sanity:migrate:nyttig:write",
    "sanity:migrate:nyttig-portable-text": "npm --workspace @samfunnet/studio run sanity:migrate:nyttig-portable-text",
    "sanity:migrate:nyttig-portable-text:write": "npm --workspace @samfunnet/studio run sanity:migrate:nyttig-portable-text:write",
    "sanity:migrate:repair-content": "npm --workspace @samfunnet/studio run sanity:migrate:repair-content",
    "sanity:migrate:repair-content:write": "npm --workspace @samfunnet/studio run sanity:migrate:repair-content:write",
    "sanity:migrate:group-locales": "npm --workspace @samfunnet/studio run sanity:migrate:group-locales",
    "sanity:migrate:group-locales:write": "npm --workspace @samfunnet/studio run sanity:migrate:group-locales:write",
    "sanity:audit:group-locales": "npm --workspace @samfunnet/studio run sanity:audit:group-locales",
    "sanity:migrate:i18n": "npm --workspace @samfunnet/studio run sanity:migrate:i18n",
    "sanity:migrate:i18n:catalog": "npm --workspace @samfunnet/studio run sanity:migrate:i18n:catalog",
    "sanity:migrate:i18n:write": "npm --workspace @samfunnet/studio run sanity:migrate:i18n:write",
    "sanity:audit:i18n": "npm --workspace @samfunnet/studio run sanity:audit:i18n",
    "sanity:audit": "npm --workspace @samfunnet/studio run sanity:audit",
    "sanity:generate:instances": "npm --workspace @samfunnet/studio run sanity:generate:instances",
    "sanity:generate:instances:write": "npm --workspace @samfunnet/studio run sanity:generate:instances:write",
    "sanity:migrate:private-event-children": "npm --workspace @samfunnet/studio run sanity:migrate:private-event-children",
    "sanity:migrate:private-event-children:write": "npm --workspace @samfunnet/studio run sanity:migrate:private-event-children:write",
    "sanity:migrate:arrangement-editorial-cleanup": "npm --workspace @samfunnet/studio run sanity:migrate:arrangement-editorial-cleanup",
    "sanity:migrate:arrangement-editorial-cleanup:write": "npm --workspace @samfunnet/studio run sanity:migrate:arrangement-editorial-cleanup:write",
    "sanity:migrate:arrangement-statuses": "npm --workspace @samfunnet/studio run sanity:migrate:arrangement-statuses",
    "sanity:migrate:arrangement-statuses:write": "npm --workspace @samfunnet/studio run sanity:migrate:arrangement-statuses:write",
    "crescat:introspect": "npm --workspace @samfunnet/web run crescat:introspect",
    "crescat:cleanup": "npm --workspace @samfunnet/web run crescat:cleanup",
    "typecheck": "npm run typecheck:web && npm run typecheck:studio && npm run typecheck:domain",
    "typecheck:web": "npm --workspace @samfunnet/web run typecheck",
    "typecheck:studio": "npm --workspace @samfunnet/studio run typecheck",
    "typecheck:domain": "npm --workspace @samfunnet/content-domain run typecheck",
    "route-typegen": "npm --workspace @samfunnet/web run route-typegen",
    "test": "npm run test:web && npm run test:studio && npm run test:domain",
    "test:web": "npm --workspace @samfunnet/web run test",
    "test:studio": "npm --workspace @samfunnet/studio run test",
    "test:domain": "npm --workspace @samfunnet/content-domain run test",
    "format:check": "npx --no-install biome format .",
    "format": "npx --no-install biome format --write .",
    "lint": "npm run lint:web && npm run lint:studio",
    "lint:web": "npm --workspace @samfunnet/web run lint",
    "lint:studio": "npx --no-install biome check --skip=assist/source/organizeImports apps/studio packages/content-domain",
    "check": "npx --no-install biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "ws": "8.21.0",
    "qs": "6.15.3",
    "postcss": "8.5.18",
    "hono": "4.12.27",
    "dompurify": "3.4.12",
    "ip-address": "10.2.0",
    "sharp": "0.35.3",
    "prismjs": "1.30.0",
    "adm-zip": "0.6.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@posthog/cli@0.7.34": true,
    "core-js@3.49.0": true,
    "esbuild@0.28.1": true,
    "fsevents@3.0.0": true,
    "@swc/core@1.15.24": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
