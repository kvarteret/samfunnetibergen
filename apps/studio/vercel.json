{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash ../../scripts/vercel-ignore-build.sh studio",
  "git": {
    "deploymentEnabled": {
      "develop": false,
      "main": false
    }
  },
  "buildCommand": "corepack pnpm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://*.sanity.io https://*.sanity.build"
        }
      ]
    }
  ],
  "installCommand": "corepack pnpm install --frozen-lockfile --prefer-offline"
}
