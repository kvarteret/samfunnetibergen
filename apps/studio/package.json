{
  "name": "@samfunnet/studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "studio:register": "sanity deploy --external",
    "studio:seed": "sanity exec scripts/seed-sanity-content.mjs --with-user-token",
    "sanity:schema": "sanity schema extract --force --enforce-required-fields --path ../../.sanity/schema.json",
    "sanity:typegen:web": "sanity typegen generate",
    "sanity:typegen:studio": "SANITY_TYPEGEN_TARGET=studio sanity typegen generate",
    "sanity:migrate:defaults": "sanity exec scripts/migrate-sanity-defaults.ts --with-user-token",
    "sanity:migrate:defaults:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-sanity-defaults.ts --with-user-token",
    "sanity:migrate:volunteer-links": "sanity exec scripts/migrate-retired-volunteer-links.ts --with-user-token",
    "sanity:migrate:volunteer-links:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-retired-volunteer-links.ts --with-user-token",
    "sanity:migrate:group-slugs": "sanity exec scripts/migrate-student-group-slugs.ts --with-user-token",
    "sanity:migrate:group-slugs:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-student-group-slugs.ts --with-user-token",
    "sanity:migrate:nyttig": "sanity exec scripts/migrate-nyttig-info.ts --with-user-token",
    "sanity:migrate:nyttig:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-nyttig-info.ts --with-user-token",
    "sanity:migrate:nyttig-portable-text": "sanity exec scripts/migrate-nyttig-portable-text.ts --with-user-token",
    "sanity:migrate:nyttig-portable-text:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-nyttig-portable-text.ts --with-user-token",
    "sanity:migrate:repair-content": "sanity exec scripts/repair-sanity-content.ts --with-user-token",
    "sanity:migrate:repair-content:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/repair-sanity-content.ts --with-user-token",
    "sanity:audit": "sanity exec scripts/audit-sanity-content.ts --with-user-token",
    "sanity:generate:instances": "sanity exec scripts/generate-event-instances.ts --with-user-token",
    "sanity:generate:instances:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/generate-event-instances.ts --with-user-token",
    "sanity:migrate:private-event-children": "sanity exec scripts/migrate-private-event-children.ts --with-user-token",
    "sanity:migrate:private-event-children:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-private-event-children.ts --with-user-token",
    "sanity:migrate:arrangement-editorial-cleanup": "sanity exec scripts/migrate-arrangement-editorial-cleanup.ts --with-user-token",
    "sanity:migrate:arrangement-editorial-cleanup:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-arrangement-editorial-cleanup.ts --with-user-token",
    "sanity:migrate:arrangement-statuses": "sanity exec scripts/migrate-arrangement-statuses.ts --with-user-token",
    "sanity:migrate:arrangement-statuses:write": "SANITY_MIGRATION_WRITE=1 sanity exec scripts/migrate-arrangement-statuses.ts --with-user-token",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@portabletext/markdown": "^1.4.4",
    "@sanity/assist": "^6.1.17",
    "@sanity/client": "^7.25.0",
    "@sanity/icons": "^5.2.1",
    "@sanity/orderable-document-list": "^2.0.18",
    "@sanity/vision": "^6.7.0",
    "@samfunnet/content-domain": "0.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rrule": "^2.8.1",
    "sanity": "^6.7.0",
    "sanity-plugin-markdown": "^9.0.9",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
