{
  "name": "@samfunnet/studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "studio:register": "sanity deploy --external",
    "studio:seed": "sanity exec scripts/seed-sanity-content.mjs --with-user-token",
    "sanity:schema": "sanity schema extract --force --enforce-required-fields --path ../../.sanity/schema.json",
    "sanity:typegen:web": "sanity typegen generate",
    "sanity:typegen:studio": "SANITY_TYPEGEN_TARGET=studio sanity typegen generate",
    "sanity:audit:group-locales": "sanity exec scripts/audit-group-locales.ts --with-user-token",
    "sanity:audit:i18n": "sanity exec scripts/audit-i18n-content.ts --with-user-token",
    "sanity:audit": "sanity exec scripts/audit-sanity-content.ts --with-user-token",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@portabletext/markdown": "^1.4.4",
    "@samfunnet/content-domain": "0.1.0",
    "@sanity/assist": "^6.1.17",
    "@sanity/client": "^7.25.0",
    "@sanity/icons": "^5.2.1",
    "@sanity/language-filter": "^5.0.16",
    "@sanity/orderable-document-list": "^2.0.18",
    "@sanity/vision": "^6.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rrule": "^2.8.1",
    "sanity": "^6.7.0",
    "sanity-plugin-internationalized-array": "^5.1.27",
    "sanity-plugin-markdown": "^9.0.9",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
