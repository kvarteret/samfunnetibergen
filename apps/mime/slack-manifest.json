{
  "display_information": {
    "name": "Ludvig",
    "description": "E-tjenesten's lille hjelper.",
    "background_color": "#1d1c1d"
  },
  "features": {
    "bot_user": { "display_name": "Ludvig", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://mime.WORKERS_SUBDOMAIN.workers.dev/slack/interactions"
    },
    "event_subscriptions": {
      "request_url": "https://mime.WORKERS_SUBDOMAIN.workers.dev/slack/events",
      "bot_events": ["app_mention"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
