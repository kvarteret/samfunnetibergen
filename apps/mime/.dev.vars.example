# Copy to .dev.vars (gitignored) for `npm run dev:mime`. Use a test Slack app.
ALLOWED_CHANNELS=C0123456789
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SANITY_MIME_READ_TOKEN=...
# Optional Editor token: turns on write plans (propose, then a human says ja).
# SANITY_MIME_WRITE_TOKEN=...
AZURE_OPENAI_ENDPOINT=https://kvarteret-nor-east-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=...
# Optional: render JavaScript-drawn pages (API token with Browser Rendering: Edit).
# BROWSER_RENDERING_TOKEN=...
# Optional: turn on GET /feedback (Authorization: Bearer <this>).
# FEEDBACK_EXPORT_TOKEN=...
# Optional: Sanity Context search (see README).
# SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-11-03/context/organizations/ohrUT7FPF/mcp/mime
# SANITY_CONTEXT_TOKEN=...
# Optional: event statistics from the website. Locally, run the website with
# STATISTICS_MCP_TOKEN_SHA256 set to this token's SHA-256.
# STATISTICS_MCP_TOKEN=...
# STATISTICS_MCP_URL=http://localhost:3000/api/mcp/statistikk
# Optional: PostHog LLM analytics (the website's phc_ key); content only with POSTHOG_CONTENT=on.
# POSTHOG_PROJECT_TOKEN=phc_...
# WEB_SEARCH=off
# For npm run ask:mime: your Slack member ID, and optionally a private test channel
# (add it to ALLOWED_CHANNELS too).
# MIME_TEST_USER=U0123456789
# MIME_TEST_CHANNEL=C0123456789
