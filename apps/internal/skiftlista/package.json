{
  "name": "@samfunnet/skiftlista",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3190 --strictPort",
    "build": "vite build",
    "build:demo": "VITE_LEADER_API=http vite build --outDir dist-demo --emptyOutDir && cp demo/vercel.json dist-demo/vercel.json",
    "preview": "vite preview --port 3190",
