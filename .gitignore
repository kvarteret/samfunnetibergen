# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/apps/web/.next/
/apps/web/out/
/apps/studio/dist/
/apps/studio/.sanity/
/.sanity/

# production
/build
/apps/web/build
/apps/studio/build
/storybook-static
/dist
/apps/web/dist
/apps/studio/dist
/tmp

# misc
.DS_Store
*.pem
/.claude/
/.codex/*
!/.codex/agents/
!/.codex/agents/*.toml
!/.codex/environments/
!/.codex/environments/environment.toml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# hey-api generated files — committed intentionally (see scripts/)

# HAR captures (may contain session cookies / PII)
*.har

# SonarQube project config (contains token)
sonar-project.properties
.ralph/
.scannerwork/
.agents/design-system.md
.env.vercel.production
.env.vercel.preview
