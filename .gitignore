# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.sanity/

# production
/build
/storybook-static
/dist
/tmp

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# hey-api generated files
src/lib/integrations/kvarteret-personal-api/

# HAR captures (may contain session cookies / PII)
*.har

# SonarQube project config (contains token)
sonar-project.properties
.ralph/
.scannerwork/
.agents/design-system.md
